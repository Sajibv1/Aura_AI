GROQ_API_KEY=your_groq_api_key_here
# Optional fallback if primary key is rate-limited or fails
GROQ_FALLBACK_API_KEY=your_fallback_groq_api_key_here

# Firecrawl for JS-rendered / anti-bot webpages (https://firecrawl.dev)
# Optional — without it, only basic HTTP+Cheerio scraping is used
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# NextAuth.js encryption key (generate with: openssl rand -base64 32)
AUTH_SECRET=your_random_secret_at_least_32_chars

# For production / Vercel deployment, add these to the OAuth client:
#   Authorized JS origins: https://<your-app>.vercel.app
#   Redirect URIs:         https://<your-app>.vercel.app/api/auth/callback/google
# Also set AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, AUTH_SECRET in Vercel env vars.
