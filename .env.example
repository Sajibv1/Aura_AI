OPENAI_API_KEY=your_openai_api_key_here
# Optional fallback if primary key is rate-limited or fails
OPENAI_FALLBACK_API_KEY=your_fallback_openai_api_key_here

# Firecrawl for JS-rendered / anti-bot webpages (https://firecrawl.dev)
# Optional — without it, only basic HTTP+Cheerio scraping is used
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Tavily for web search (https://tavily.com — free tier, no credit card)
# Optional but recommended for serverless deploys (Vercel): DuckDuckGo's
# keyless endpoints often block datacenter IPs, Tavily does not
TAVILY_API_KEY=your_tavily_api_key_here
